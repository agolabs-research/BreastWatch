<Window x:Name="InspectorWindow" x:Class="BreastWatch.PropPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:BreastWatch"
        mc:Ignorable="d"
        Title="Data Inspector" Width="330" WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow" HorizontalAlignment="Center" Height="300">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BreastWatch.esapi;component/Dictionary2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="PropRecords" Text="FILTERED RECORDS = " Margin="5,0,5,0" VerticalAlignment="Center" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Histogram">
                <TabItem.DataContext>
                    <local:InspectorViewModel/>
                </TabItem.DataContext>

                <Grid x:Name="InspectorGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <oxy:PlotView x:Name="InspectorPlotView" Model="{Binding MyModelInspector, Mode=OneWay}" ToolTip="RED BAR = Current Result; BLUE BARS = Avg and Avg+1SD; MAGENTA BARS = Constraints" Margin="5,0,0,0"/>
                    <Grid Grid.Column="1" x:Name="InspectorLabels">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Min" VerticalAlignment="Center"></Label>
                        <Label Grid.Row="1" Content="Max" VerticalAlignment="Center"></Label>
                        <Label Grid.Row="2" Content="Avg" VerticalAlignment="Center"></Label>
                        <Label Grid.Row="3" Content="SD" VerticalAlignment="Center"></Label>
                        <Label Grid.Row="4" Content="SCORE" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="2" x:Name="InspectorResults">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label x:Name="StatsMin" Grid.Row="0" Content="min" VerticalAlignment="Center"></Label>
                        <Label x:Name="StatsMax" Grid.Row="1" Content="max" VerticalAlignment="Center"></Label>
                        <Label x:Name="StatsAvg" Grid.Row="2" Content="avg" VerticalAlignment="Center"></Label>
                        <Label x:Name="StatsDevSt" Grid.Row="3" Content="sd" VerticalAlignment="Center"></Label>
                        <Label x:Name="StatsScore" Grid.Row="4" Content="score" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Chrono">
                <TabItem.DataContext>
                    <local:InspectorViewModelChrono/>
                </TabItem.DataContext>
                <oxy:PlotView x:Name="InspectorPlotViewChrono" Model="{Binding MyModelInspectorChrono, Mode=OneWay}" ToolTip="Time series of records with 10-points MOVING AVERAGE and +/- 1SD BANDS. RED DOT = Current Result; MAGENTA BARS = Constraints" Margin="5,5,5,5"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Height="8"/>
    </Grid>

</Window>
