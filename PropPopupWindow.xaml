<Window x:Name="InspectorWindow" x:Class="BreastWatch.PropPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:BreastWatch"
        mc:Ignorable="d"
        Title="Data Inspector" Width="300" WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow" HorizontalAlignment="Center" Height="300">

    <Window.DataContext>
        <local:InspectorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BreastWatch.esapi;component/Dictionary2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
            <ToggleButton x:Name="LateralityToggleButton" Content="LATERALITY" HorizontalContentAlignment="Center" Margin="5" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
            <ToggleButton x:Name="AddTargetsToggleButton" Content="wADDT" HorizontalContentAlignment="Center" Margin="0,5,5,5" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
            <ToggleButton x:Name="TechniqueToggleButton" Content="TECHNIQUE" HorizontalContentAlignment="Center" Margin="0,5,5,5" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
            <ToggleButton x:Name="USERToggleButton" Content="USER" HorizontalContentAlignment="Center" Margin="0,5,5,5" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Grid.Row="1" Orientation="Horizontal">
            <TextBlock x:Name="PropRecords" Text="FILTERED RECORDS = " Margin="5,0,5,0" VerticalAlignment="Center" />
        </StackPanel>
        <Grid x:Name="InspectorGrid" Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="20*"/>
        </Grid.ColumnDefinitions>
        <oxy:PlotView x:Name="InspectorPlotView" Model="{Binding MyModelInspector, Mode=OneWay}" ToolTip="RED BAR = Current Result; BLUE BARS = Avg and Avg+1SD; MAGENTA BARS = Constraints" Margin="5,0,0,0"/>
        <Grid Grid.Column="1" x:Name="InspectorLabels">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Min" VerticalAlignment="Center"></Label>
            <Label Grid.Row="1" Content="Max" VerticalAlignment="Center"></Label>
            <Label Grid.Row="2" Content="Avg" VerticalAlignment="Center"></Label>
            <Label Grid.Row="3" Content="SD" VerticalAlignment="Center"></Label>
            <Label Grid.Row="4" Content="SCORE" VerticalAlignment="Center"/>
            </Grid>
        <Grid Grid.Column="2" x:Name="InspectorResults">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="43.897"/>
                <RowDefinition Height="43.897"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label x:Name="StatsMin" Grid.Row="0" Content="min" VerticalAlignment="Center"></Label>
            <Label x:Name="StatsMax" Grid.Row="1" Content="max" VerticalAlignment="Center"></Label>
            <Label x:Name="StatsAvg" Grid.Row="2" Content="avg" VerticalAlignment="Center"></Label>
            <Label x:Name="StatsDevSt" Grid.Row="3" Content="sd" VerticalAlignment="Center"></Label>
            <Label x:Name="StatsScore" Grid.Row="4" Content="score" VerticalAlignment="Center"/>
        </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Height="14"/>
    </Grid>


</Window>
