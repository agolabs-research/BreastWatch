<UserControl x:Class="BreastWatch.UserControlFilterPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BreastWatch"
             mc:Ignorable="d" 
             d:DesignWidth="400" d:DesignHeight="250" >
    <UserControl.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightLightColorKey}}"/>
    </UserControl.Background>
    <GroupBox Width="400" Height="250" Header="Filters">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="Filter_Users_AllRadioButton" Content="All available" IsChecked="true" VerticalAlignment="Center" Checked="Filter_Targets_ChestWall_Click"/>
            <RadioButton x:Name="Filter_Users_CurrentRadioButton" Content="Current user" Grid.Row="1" VerticalAlignment="Center" Checked="Filter_Targets_ChestWall_Click"/>

            <TextBlock x:Name="AllAvailableFilterCountTextBlock" Text="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentUserFilterCountTextBlock" Text="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"/>

            <CheckBox x:Name="BreastLatCheckBox" Content="Breast Laterality" IsChecked="true" IsEnabled="false" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <ComboBox x:Name="Filter_BreastLaterality_ComboBox" Grid.Column="1" Grid.Row="2" SelectedIndex="0" VerticalAlignment="Center" Height="22" HorizontalAlignment="Center" Width="100" SelectionChanged="Filter_Targets_ChestWall_Click">
                <ComboBoxItem Content="LEFT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBoxItem Content="RIGHT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBoxItem Content="BILATERAL" Background="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ComboBox>

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox x:Name="Filter_Setup_PBI" Content="PBI" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" IsEnabled="False"/>
                <CheckBox x:Name="Filter_Setup_Prone" Content="Prone" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="False"/>
            </StackPanel>

            <CheckBox x:Name="TargetsCheckBox" Content="Targets" IsChecked="true"  IsEnabled="false" Grid.Row="4" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ToggleButton x:Name="Filter_Targets_BreastToggleButton" Content="Breast" Width="50" HorizontalAlignment="Center" Height="22" IsChecked="True" IsHitTestVisible="False"/>
                <ToggleButton x:Name="Filter_Targets_BoostToggleButton" Content="Boost" Width="50" HorizontalAlignment="Center" Height="22" Margin="5,0,5,0" IsHitTestVisible="True" Click="Filter_Targets_ChestWall_Click"/>
                <ToggleButton x:Name="Filter_Targets_SPCNToggleButton" Content="SPC/N" Width="50" HorizontalAlignment="Center" Height="22" IsHitTestVisible="True" Click="Filter_Targets_ChestWall_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <CheckBox x:Name="Filter_Targets_ChestWall" Content="ChestWall" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" Click="Filter_Targets_ChestWall_Click"/>
                <Separator Width="20" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5" Height="5">
                    <Separator.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Separator.RenderTransform>
                </Separator>
                <CheckBox x:Name="Filter_Targets_ChestWall_EXP" Content="Expander" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" Click="Filter_Targets_ChestWall_Click"/>
                <CheckBox x:Name="Filter_Targets_ChestWall_EXP_HS" Content="Expander HS" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" Click="Filter_Targets_ChestWall_Click"/>
            </StackPanel>

            <CheckBox x:Name="TechniqueCheckBox" Content="Technique" IsChecked="true" Grid.Row="6" VerticalAlignment="Center" IsEnabled="False" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Center">
            <ComboBox x:Name="Filter_Technique_ComboBox"  SelectedIndex="0" VerticalAlignment="Center" Width="100" SelectionChanged="Filter_Targets_ChestWall_Click">
                <ComboBoxItem Content="3DRCT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBoxItem Content="IMRT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBoxItem Content="VMAT/RA" Background="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ComboBox>
                <CheckBox x:Name="Filter_Technique_Hybrid" Content="Hybrid" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" Click="Filter_Targets_ChestWall_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Grid.RowSpan="3">
                <CheckBox x:Name="Filter_Technique_BreathHold" Content="Breath Hold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" Click="Filter_Targets_ChestWall_Click"/>
                <CheckBox x:Name="Filter_Technique_Tangential" Content="Tangential" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,5,0" Click="Filter_Targets_ChestWall_Click"/>
                <CheckBox x:Name="Filter_Technique_Autoplanned" Content="Autoplanned" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Filter_Targets_ChestWall_Click"/>
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>
