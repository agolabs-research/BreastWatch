<Window x:Name="PscWindow1" x:Class="BreastWatch.PscWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BreastWatch"
        mc:Ignorable="d"
        Title="Plan Sanity Check" Height="200" Width="200" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="TestsGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid HorizontalAlignment="Left" Height="100" Margin="10,10,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Isocenters check" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="Dose rate" Margin="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="VMAT Jaw angle" Margin="0" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="Couch rotation" Margin="0" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="Field X wMLC" Margin="0" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Content="MU Sum" Margin="0" Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ContentControl x:Name="BeamsISOTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" />
        <ContentControl x:Name="BeamsISOTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" />
        <ContentControl x:Name="DoseRateTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" Grid.Row="1" />
        <ContentControl x:Name="DoseRateTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" Grid.Row="1" />
        <ContentControl x:Name="JawAngleTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" Grid.Row="2" />
        <ContentControl x:Name="JawAngleTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" Grid.Row="2" />
        <ContentControl x:Name="CouchRtnTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" Grid.Row="3" />
        <ContentControl x:Name="CouchRtnTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" Grid.Row="3" />
        <ContentControl x:Name="FieldXMLCTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" Grid.Row="4" />
        <ContentControl x:Name="FieldXMLCTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" Grid.Row="4" />
        <ContentControl x:Name="MUSumTestFailed" Content="{StaticResource TestFailed}" Grid.Column="1" Grid.Row="5" MouseDoubleClick="MUSumTestPassed_MouseDoubleClick" />
        <ContentControl x:Name="MUSumTestPassed" Content="{StaticResource TestPassed}" Grid.Column="1" Grid.Row="5" MouseDoubleClick="MUSumTestPassed_MouseDoubleClick" />
    </Grid>
</Window>
