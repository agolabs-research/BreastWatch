                    <ColumnDefinition Width="30*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PlanScoreLabel" TextWrapping="Wrap" Text="BW Score" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
