        </Grid>

        <GroupBox Header="Technique" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,133,438" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300*"/>
                    <RowDefinition Height="200*"/>
                    <RowDefinition Height="300*"/>
                </Grid.RowDefinitions>

                <Grid Grid.ColumnSpan="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="Technique3DCRT" GroupName="Technique" Content="3DCRT" ToolTip="3D conformal static beams" IsEnabled="False" VerticalAlignment="Center">
                    </RadioButton>
                    <RadioButton x:Name="TechniqueIMRT" GroupName="Technique" Content="IMRT" ToolTip="Intensity modulated static beams" IsEnabled="False" Grid.Row="1" VerticalAlignment="Center">
                    </RadioButton>
                    <RadioButton x:Name="TechniqueVMAT" GroupName="Technique" Content="VMAT/RA" ToolTip="VMAT/RapidArc arc beams" IsEnabled="False" VerticalAlignment="Center" Grid.Row="2">
                    </RadioButton>
                </Grid>
                <Grid Margin="0,5,0,0" Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="BoostCheckBox" Content="with Boost" Click="BoostCheckBox_Click" ToolTip="Plan includes Boost irradiation" VerticalAlignment="Center">
                    </CheckBox>
                    <CheckBox x:Name="SPCNCheckBox" Content="with SPC/N" Click="SPCNCheckBox_Click" ToolTip="Plan includes SPC/N irradiation" Grid.Row="1" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="BreathHoldCheckBox" Content="Breath Hold" ToolTip="Breath Hold gating: adds BH to TECHNIQUE" VerticalAlignment="Center" Click="BreathHoldCheckBox_Click">
                    </CheckBox>
                    <CheckBox x:Name="TangentialCheckBox" Content="Tangential" ToolTip="&quot;Tangential&quot; beams/arcs: adds TANG to TECHNIQUE" Grid.ColumnSpan="4" Grid.Row="1" VerticalAlignment="Center">
                    </CheckBox>
                    <CheckBox x:Name="AutoPlannedCheckBox" Content="Autoplanned" ToolTip="Autoplanned plan: adds AUTO to TECHNIQUE" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="SUMCheckBox" Content="SUM" IsEnabled="False" ToolTip="Plan Sum" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <CheckBox x:Name="HybridCheckBox" Content="Hybrid" ToolTip="Hybrid technique (e.g. 3D+IM): adds HYBRID to TECHNIQUE" IsEnabled="False" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="1"/>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid x:Name="LateralityBolus" Grid.Column="4" Margin="0,0,0,438" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="750*"/>
                <RowDefinition Height="250*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Laterality &amp; Setup">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66*"/>
                        <ColumnDefinition Width="34*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <RadioButton x:Name="LeftBreastRadio" Content="Left Breast" GroupName="LateralityGroup" Click="LeftBreastRadio_Click" VerticalAlignment="Center">
                        </RadioButton>
                        <RadioButton x:Name="RightBreastRadio" Content="Right Breast" GroupName="LateralityGroup" Click="RightBreastRadio_Click" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center">
                        </RadioButton>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ProneCheckBox" Content="PRONE" ToolTip="If checked adds &quot;PRONE&quot; in LATERALITY" VerticalAlignment="Center" Click="ProneCheckBox_Click">
                        </CheckBox>
                        <CheckBox x:Name="BilateralCheckBox" Content="BILATERAL" ToolTip="If checked adds &quot;BIL&quot; in LATERALITY" Click="BilateralCheckBox_Click" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center">
                        </CheckBox>
                    </Grid>
                    <Grid Grid.Column="1" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="PBICheckBox" Content="PBI" Click="PBICheckClick" ToolTip="If checked adds &quot;PBI&quot; in LATERALITY" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Center">
                        </CheckBox>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Header="Bolus" Grid.Row="1">
                <ComboBox x:Name="BolusComboBox" SelectedIndex="2" VerticalAlignment="Center" Grid.Column="2">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Partial"/>
                    <ComboBoxItem Content="Always"/>
                </ComboBox>
            </GroupBox>

        </Grid>

