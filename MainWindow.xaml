                <TextBlock x:Name="PlanScoreText" Text="{Binding Value, ElementName=PlanScore, StringFormat=\{0:0\}%}" VerticalAlignment="Center" Grid.Column="2" HorizontalAlignment="Left" Margin="5,0,0,0"/>
