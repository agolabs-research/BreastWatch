<Window x:Name="MainCommentWindow" x:Class="BreastWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:BreastWatch"
        mc:Ignorable="d"
        Title="Breast Watch 1.8.3.3 - Developed by Stefano Agostinelli - Research Use Only" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Width="1280" Height="715" Loaded="MainCommentWindow_Loaded">

    <Window.DataContext>
        <local:InspectorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BreastWatch.esapi;component/Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="MainGrid" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="377*"/>
            <ColumnDefinition Width="135*"/>
            <ColumnDefinition Width="492*"/>
            <ColumnDefinition Width="133*"/>
            <ColumnDefinition Width="133*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300*"/>
            <RowDefinition Height="640*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="InfoBox" Header="Info" Grid.ColumnSpan="2" Margin="0,0,0,438" Grid.RowSpan="2">
            <Grid x:Name="InfoBoxGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="35*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="23*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150*"/>
                    <RowDefinition Height="150*"/>
                    <RowDefinition Height="150*"/>
                    <RowDefinition Height="150*"/>
                    <RowDefinition Height="150*"/>
                    <RowDefinition Height="150*"/>
                </Grid.RowDefinitions>
                <Label Content="PAT Name (ID)" VerticalAlignment="Center">
                </Label>
                <TextBlock x:Name="PatientNameID" TextWrapping="Wrap" Text="Patient name (ID)" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Grid.ColumnSpan="3"/>
                <Label Content="Birth (Age)" VerticalAlignment="Center" Grid.Row="1">
                </Label>
                <TextBlock x:Name="PatientBirthAge" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="3" Grid.Row="1"><Run Text="Birth (Age)"/></TextBlock>
                <Label x:Name="PlanIdLabel" VerticalAlignment="Center" Grid.Row="2">
                    <Hyperlink x:Name="PscHyperLink" Click="PscHandler">PLAN</Hyperlink>
                </Label>
                <Label Content="Prescription" VerticalAlignment="Center" Grid.Row="3">
                </Label>
                <TextBlock x:Name="PlanId" TextWrapping="Wrap" Text="Plan Id" Grid.Column="1" VerticalAlignment="Center" Grid.Row="2"/>
                <TextBlock x:Name="Prescription" TextWrapping="Wrap" RenderTransformOrigin="0.106,-0.622" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="3" Grid.Row="3"><Run Text="Prescription"/></TextBlock>
                <Label Content="Target Volume" VerticalAlignment="Center" Grid.Row="4">
                </Label>
                <Label Content="Body Dmax" VerticalAlignment="Center" Grid.Row="5">
                </Label>
                <TextBlock x:Name="Target" TextWrapping="Wrap" Text="Target" RenderTransformOrigin="0.106,-0.622" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="3" Grid.Row="4"/>
                <TextBlock x:Name="BodyDmax" TextWrapping="Wrap" Text="Body Dmax" RenderTransformOrigin="0.106,-0.622" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="3" Grid.Row="5"/>
                <Label Content="TX UNIT =" VerticalAlignment="Center" Grid.Column="2" HorizontalAlignment="Right" Grid.Row="2"/>
                <TextBlock x:Name="TXUnitId" TextWrapping="Wrap" Text="Unit Id" Grid.Column="3" VerticalAlignment="Center" Grid.Row="2"/>
            </Grid>
        </GroupBox>

        <Grid x:Name="ProtocolExport" Grid.Column="1" Grid.ColumnSpan="3" Margin="135,0,133,438" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="300*"/>
                <RowDefinition Height="700*"/>
            </Grid.RowDefinitions>
            <GroupBox x:Name="ProtocolBox" Header="Protocol">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="62*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Pat PID"  VerticalAlignment="Center"/>
                    <TextBox x:Name="ProtocolID" VerticalAlignment="Center" MinHeight="24" Grid.Column="1" VerticalContentAlignment="Center"/>
                    <Label x:Name="ProtocolLabel" Content="Protocol"  VerticalAlignment="Center" Grid.Column="2"/>
                    <ComboBox x:Name="ProtocolComboBox" IsReadOnly="True" VerticalAlignment="Center" SelectionChanged="ProtocolComboBox_SelectionChanged" MinHeight="24" Grid.Column="3" Grid.Row="1">
                        <ComboBoxItem Content="RTOG1005 ARM II: 40.05/48 Gy (15 FR) v1.2" IsEnabled="False"/>
                        <ComboBoxItem Content="UK FAST FORWARD ARM 2: 26/30 Gy (5 FR) v1.1" IsEnabled="False"/>
                        <ComboBoxItem Content="UK FAST ARM 2: 28.5/31 Gy (5 FR) v1.0" IsEnabled="False"/>
                        <ComboBoxItem Content="EUROPA WBI: 40.05 Gy (15 FR) v1.1" IsEnabled="False"/>
                        <ComboBoxItem Content="EUROPA WBI: 26 Gy (5 FR) v1.0" IsEnabled="False"/>
                        <ComboBoxItem Content="EUROPA PBI: 30 Gy (5 FR) v1.0" IsEnabled="False"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="ExportBox" Header="Export" Grid.ColumnSpan="2" Grid.RowSpan="2" Grid.Row="1">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="4.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Label Content="Export Drawer" Canvas.Left="590" Canvas.Top="58" RenderTransformOrigin="0.531,-0.692" VerticalAlignment="Center" HorizontalAlignment="Left">
                    </Label>
                    <TextBox x:Name="ExportDrawer" Canvas.Left="673" Canvas.Top="59" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True" Grid.ColumnSpan="3" MinHeight="24" VerticalContentAlignment="Center">
                    </TextBox>
                    <Label Content="Export File" Canvas.Left="589" Canvas.Top="94" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1">
                    </Label>
                    <TextBox x:Name="ExportFileName" Canvas.Left="673" Canvas.Top="96" RenderTransformOrigin="0.492,1.696" Grid.Column="1" VerticalAlignment="Center" Height="24" IsReadOnly="True" MinHeight="24" Grid.Row="1" VerticalContentAlignment="Center">
                    </TextBox>
                    <CheckBox x:Name="WriteHeadersCheckBox" Content="write headers" Canvas.Left="1098" Canvas.Top="650" ToolTip="Adds a row containing Headers in the Export File" Grid.Column="2" HorizontalAlignment="Left" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    <Label Content="Comments" Canvas.Left="456" Canvas.Top="122" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center">
                    </Label>
                    <TextBox x:Name="CommentsBox" Canvas.Left="84" Grid.Column="1" Canvas.Top="0" ToolTip="This will be added in the export file" Background="WhiteSmoke" MinHeight="24" Grid.Row="2" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    </TextBox>
                    <TextBox x:Name="RecordsInFile" Grid.Column="2" Height="24" TextWrapping="Wrap" Text="RECS = " VerticalAlignment="Center" IsReadOnly="True" ToolTip="Number of records (user/all) found in Export File" Grid.Row="1" Margin="5,0,5,0" VerticalContentAlignment="Center"/>
                    <Rectangle x:Name="Table" Height="24" Width="24" Grid.Column="3" HorizontalAlignment="Left" ToolTip="Data Inspector USER DATA ONLY." Grid.Row="1" VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <DrawingBrush>
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                                        <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M1,15L16,15 16,1 1,1z" />
                                        <GeometryDrawing Brush="#FFEFEFF0" Geometry="F1M11,7L14,7 14,5 11,5z M11,10L14,10 14,8 11,8z M11,13L14,13 14,11 11,11z M7,7L10,7 10,5 7,5z M7,10L10,10 10,8 7,8z M7,13L10,13 10,11 7,11z M3,7L6,7 6,5 3,5z M3,10L6,10 6,8 3,8z M3,11L6,11 6,13 3,13z" />
                                        <GeometryDrawing Brush="#FF424242" Geometry="F1M14,7L11,7 11,5 14,5z M14,10L11,10 11,8 14,8z M14,13L11,13 11,11 14,11z M10,7L7,7 7,5 10,5z M10,10L7,10 7,8 10,8z M10,13L7,13 7,11 10,11z M6,7L3,7 3,5 6,5z M6,10L3,10 3,8 6,8z M6,13L3,13 3,11 6,11z M2,14L15,14 15,2 2,2z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
