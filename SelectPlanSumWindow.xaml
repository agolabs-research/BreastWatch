<Window x:Name="SelectPlanSumAskWindow" x:Class="BreastWatch.SelectPlanSumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BreastWatch"
        mc:Ignorable="d"
        Title="Breast Watch" Height="190" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Content="Please select one of the open Plan Sums:" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <StackPanel HorizontalAlignment="Center" Margin="67,135,67,0" VerticalAlignment="Top" Orientation="Horizontal" Grid.ColumnSpan="2">
            <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Top" Width="75" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
        <ListBox x:Name="PlanSumsListBox" HorizontalAlignment="Center" Height="85" Margin="7,35,7,0" VerticalAlignment="Top" Width="280" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
